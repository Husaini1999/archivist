TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
ARCHIVIST_TIMEZONE=Asia/Kuala_Lumpur
ARCHIVIST_PROJECT_ROOTS=
# Optional. Software clone vs personal instance:
# leave empty to store memory+SQLite inside this clone (fine for a private instance).
# set to a separate private git checkout to keep history off the public product repo.
ARCHIVIST_HOME=
# Prisma CLI uses this (relative to prisma/). The Node app stores the live DB under ARCHIVIST_HOME/data/.
DATABASE_URL="file:../data/archivist.db"
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
APPROVAL_TTL_HOURS=48
SCHEDULER_CATCH_UP=true
